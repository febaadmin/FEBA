DJANGO_ENV=dev
SECRET_KEY=dev-secret-key-not-for-production-use-change-me
DATABASE_URL=postgresql://feba_user:feba_dev_pass@postgres-dev:5432/feba_dev
REDIS_URL=redis://redis-dev:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,backend-dev
MEDIA_ROOT=/app/media
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# P4 — Mailpit tourne déjà comme service Docker (voir docker-compose.yml)
# spécifiquement pour que les envois de courrier en développement soient
# VÉRIFIABLES (http://localhost:8025) au lieu d'être écrits dans la
# console et déclarés « échoués » par conception (voir
# apps/monthly_reports/emails.py — un backend local n'est jamais compté
# comme un envoi réussi). Pointer vers lui est donc le choix par défaut
# correct pour le développement, pas une option parmi d'autres.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@globalfeba.com
FEBA_FROM_EMAIL=
FHA_FROM_EMAIL=
EMAIL_REPLY_TO=
# ── Salles virtuelles : instance Jitsi AUTO-HÉBERGÉE ────────────────────
#
# VOLONTAIREMENT VIDE. Il n'y a pas de valeur de repli publique, même en
# développement : `meet.jit.si` est refusé par le backend, et l'avoir eu
# ici comme défaut est ce qui a fait croire, pendant plusieurs livraisons,
# que la visioconférence « marchait ».
#
# « make jitsi-up » démarre la pile locale et renseigne cette variable
# (localhost:8443) ainsi que les deux secrets ci-dessous.
JITSI_DOMAIN=

# Instance Jitsi auto-hébergée (JWT) — voir docker-compose.jitsi.yml
JITSI_APP_ID=
JITSI_APP_SECRET=

# P7 — Adresse INTERNE (réseau Docker) que CE backend utilise pour tester
# Jitsi lui-même. « make install » la remplit avec http://jitsi-web:80 —
# jamais avec localhost, qui depuis l'intérieur d'un conteneur backend ne
# désigne que ce conteneur.
JITSI_INTERNAL_URL=

# Relances automatiques des paiements : DÉSACTIVÉES en développement. Même
# activées, les e-mails partiraient vers Mailpit (http://localhost:8025),
# jamais vers une vraie boîte. Voir PAYMENT_REMINDERS_GUIDE.md.
PAYMENT_REMINDERS_ENABLED=False

# ── Qualification du transport e-mail ───────────────────────────────────
# Mailpit (EMAIL_HOST=mailpit) CAPTURE les messages : ils sont lisibles sur
# http://localhost:8025 et n'atteignent JAMAIS une vraie boîte. FEBA les
# affiche « capturés — non distribués ». Pour des envois réels, voir
# EMAIL_CONFIGURATION_GUIDE.md § 3 (fournisseur SMTP réel).
EMAIL_DELIVERY_MODE=auto
MAILPIT_UI_URL=http://localhost:8025
# Pièces jointes (validation serveur)
EMAIL_ATTACHMENT_MAX_FILE_MB=10
EMAIL_ATTACHMENT_MAX_TOTAL_MB=20
EMAIL_ATTACHMENT_MAX_FILES=10

# ── Visioconférence : plugNmeet (remplace Jitsi) ─────────────────────
# Pile locale : scripts/plugnmeet_setup.sh --local puis
#   docker compose -p feba-pnm-local -f plugnmeet/docker-compose.plugnmeet.yml \
#     --env-file plugnmeet/runtime/plugnmeet.env up -d
# Clé et secret : PNM_API_KEY / PNM_API_SECRET de plugnmeet/runtime/plugnmeet.env.
# VIDEO_PROVIDER=jitsi rétablit l'ancien moteur (retour arrière uniquement).
VIDEO_PROVIDER=plugnmeet
PLUGNMEET_SERVER_URL=http://localhost:18080
PLUGNMEET_INTERNAL_URL=http://host.docker.internal:18080
PLUGNMEET_API_KEY=
PLUGNMEET_API_SECRET=
# L'hôte de cette URL doit figurer dans ALLOWED_HOSTS (manage.py check le vérifie).
PLUGNMEET_WEBHOOK_URL=
PLUGNMEET_RECORDING_ENABLED=False
PLUGNMEET_RTMP_ENABLED=False
PLUGNMEET_INSIGHTS_ENABLED=False

# ── SMS (copie des e-mails et des relances) ──────────────────────────
# capture : les SMS sont enregistrés dans FEBA et ne partent JAMAIS.
SMS_ENABLED=False
SMS_PROVIDER=capture
SMS_FROM_NUMBER=+12157155406
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_STATUS_CALLBACK_URL=
SMS_REQUIRE_EXPLICIT_CONSENT=True
SMS_DEFAULT_REGIONS=FEBA:BJ
SMS_MAX_MESSAGES_PER_NOTIFICATION=5
