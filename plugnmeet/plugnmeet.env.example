# Modèle des variables plugNmeet. Le VRAI fichier est
# plugnmeet/runtime/plugnmeet.env, GÉNÉRÉ par scripts/plugnmeet_setup.sh
# (secrets aléatoires, mode 600, jamais versionné). Ce modèle sert à
# valider la composition (scripts/compose_config_check.sh) et de référence.
PNM_API_KEY=CHANGE_ME
PNM_API_SECRET=CHANGE_ME
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
PNM_DB_ROOT_PASSWORD=CHANGE_ME
PNM_DB_PASSWORD=CHANGE_ME
PNM_REDIS_PASSWORD=CHANGE_ME
NATS_CALLOUT_PRIVATE_KEY=CHANGE_ME
NATS_CALLOUT_PUBLIC_KEY=CHANGE_ME
NATS_NKEY_PRIVATE_KEY=CHANGE_ME
NATS_NKEY_PUBLIC_KEY=CHANGE_ME
NATS_XKEY_PRIVATE_KEY=CHANGE_ME
NATS_XKEY_PUBLIC_KEY=CHANGE_ME
# --- paramètres (réécrits à chaque lancement du script)
PNM_DOMAIN=pnm.globalfeba.com
PNM_PUBLIC_IP=203.0.113.10
PNM_PUBLIC_URL=https://pnm.globalfeba.com
PNM_LIVEKIT_URL=https://pnm.globalfeba.com/livekit
PNM_NATS_WS_URL=https://pnm.globalfeba.com/ws
PNM_TURN_DOMAIN=pnm.globalfeba.com
LIVEKIT_TURN_ENABLED=true
LIVEKIT_UDP_PORTS=7882-7885
PNM_HTTP_HOST_PORT=8080
PNM_LIVEKIT_HOST_PORT=7880
PNM_NATS_WS_HOST_PORT=8222

# Adresse publique de FEBA : le client plugNmeet y vérifie l'académie de la
# salle (titre exact et favicon de l'onglet). Production : https://globalfeba.com
FEBA_PUBLIC_URL=https://globalfeba.com
