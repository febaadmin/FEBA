# ============================================================
# FEBA School Management — Configuration PRODUCTION
# Copiez ce fichier en .env.prod et remplissez les valeurs
# ============================================================

DJANGO_ENV=prod
# production : transports de test refusés au démarrage ; staging : préproduction.
DEPLOYMENT_STAGE=production
# Adresse publique de FEBA : retours de visioconférence, paiements Stripe.
PUBLIC_BASE_URL=https://globalfeba.com

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET_KEY

# Base de données
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://feba_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres-prod:5432/feba_prod

# Redis
REDIS_URL=redis://redis-prod:6379/0

# CORS & Hôtes (remplacez votre-domaine.com par votre domaine réel)
CORS_ALLOWED_ORIGINS=https://globalfeba.com,https://www.globalfeba.com,https://meet.globalfeba.com

# Origines autorisées à envoyer un POST avec cookie de session.
# INDISPENSABLE derrière le proxy TLS : sans cette variable, la connexion
# à /django-admin/ est refusée (« Origin checking failed »). Le schéma est
# obligatoire. Vide = dérivé d'ALLOWED_HOSTS en https.
CSRF_TRUSTED_ORIGINS=https://globalfeba.com,https://www.globalfeba.com
ALLOWED_HOSTS=globalfeba.com,www.globalfeba.com

# Médias
MEDIA_ROOT=/app/media

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Sécurité HTTPS
SECURE_SSL_REDIRECT=True
HSTS_SECONDS=31536000

# Email SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# globalfeba.com est hébergé chez Hostinger (MX mx1/mx2.hostinger.com, SPF
# include:_spf.mail.hostinger.com, DKIM hostingermail-a — relevés le
# 2026-10-25). La boîte noreply@globalfeba.com doit EXISTER chez Hostinger :
# l'expéditeur doit appartenir au compte authentifié.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=noreply@globalfeba.com
EMAIL_HOST_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
DEFAULT_FROM_EMAIL=noreply@globalfeba.com
SERVER_EMAIL=noreply@globalfeba.com

# ── Envois d'e-mails groupés (écran « E-mails groupés ») ────────────────
# Garde-fous contre un envoi massif involontaire. Voir EMAIL_CONFIGURATION_GUIDE.md.
EMAIL_TIMEOUT=10
# auto : un hôte de capture (mailpit…) est signalé « non distribué » ;
# real : force « fournisseur réel » pour un relais SMTP au nom inhabituel.
EMAIL_DELIVERY_MODE=auto
# Pièces jointes des e-mails (Mo). nginx accepte 25 Mo par requête.
EMAIL_ATTACHMENT_MAX_FILE_MB=10
EMAIL_ATTACHMENT_MAX_TOTAL_MB=20
EMAIL_ATTACHMENT_MAX_FILES=10
EMAIL_ATTACHMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,doc,docx,xls,xlsx,ppt,pptx,odt,ods,txt,csv
EMAIL_TEST_MAX_PER_HOUR=5
MASS_EMAIL_MAX_RECIPIENTS=2000
MASS_EMAIL_MAX_CAMPAIGNS_PER_HOUR=10
MASS_EMAIL_BATCH_SIZE=50

# ── Relances automatiques des paiements en retard ───────────────────────
# Interrupteur GLOBAL, faux par défaut. Ne le passer à True qu'après avoir
# vérifié les échéanciers (écran « Relances de paiement » → Échéanciers),
# fait une simulation, et activé la politique de chaque académie.
# Voir PAYMENT_REMINDERS_GUIDE.md.
PAYMENT_REMINDERS_ENABLED=False
PAYMENT_REMINDERS_HOUR=8
PAYMENT_REMINDERS_MINUTE=30

# ── Salles virtuelles : instance Jitsi AUTO-HÉBERGÉE ────────────────────
#
# `meet.jit.si` n'est pas une valeur acceptable ici, et le backend la
# refuse : les cours de FEBA FHA sont donnés à des mineurs, et une
# instance publique signifie flux chez un tiers, aucune authentification,
# et n'importe qui capable de deviner un nom de salle qui entre dedans.
#
# Domaine de l'instance du groupe (voir JITSI_PRODUCTION_GUIDE.md).
JITSI_DOMAIN=meet.globalfeba.com

# Secrets JWT — OBLIGATOIRES. Seul le backend les connaît : c'est ce qui
# fait qu'aucune salle ne s'ouvre sans une autorisation vérifiée par
# Django. Mêmes valeurs que .env.jitsi côté serveur Jitsi.
#   openssl rand -hex 32
JITSI_APP_ID=CHANGE_ME_JITSI_APP_ID
JITSI_APP_SECRET=CHANGE_ME_JITSI_APP_SECRET

# Adresse interne pour le healthcheck backend → Jitsi. Vide quand les deux
# services sont sur des serveurs distincts (le backend sonde alors
# https://meet.globalfeba.com) ; http://jitsi-web:80 s'ils partagent le
# même réseau Docker.
JITSI_INTERNAL_URL=

# ── Identité institutionnelle ───────────────────────────────────────────
# Numéro imprimé sur TOUS les documents officiels. Vide = 0160011717
# (valeur de référence, apps/schools/institution.py). À ne renseigner que
# pour un CHANGEMENT de ligne téléphonique du groupe.
FEBA_OFFICIAL_PHONE=

# ── Visioconférence : plugNmeet (remplace Jitsi) ─────────────────────
# Voir PLUGNMEET_DEPLOYMENT_GUIDE.md. Clé et secret : générés sur le
# serveur plugNmeet par scripts/plugnmeet_setup.sh (PNM_API_KEY /
# PNM_API_SECRET) — jamais dans le dépôt, jamais dans le navigateur.
# VIDEO_PROVIDER=jitsi : retour arrière vers l'instance Jitsi existante.
VIDEO_PROVIDER=plugnmeet
PLUGNMEET_SERVER_URL=https://meet.globalfeba.com
PLUGNMEET_INTERNAL_URL=
PLUGNMEET_API_KEY=CHANGE_ME
PLUGNMEET_API_SECRET=CHANGE_ME
PLUGNMEET_WEBHOOK_URL=https://globalfeba.com/api/virtual-rooms/webhook/
# À n'activer qu'une fois le service correspondant déployé et vérifié.
PLUGNMEET_RECORDING_ENABLED=False
PLUGNMEET_RTMP_ENABLED=False
PLUGNMEET_INSIGHTS_ENABLED=False

# ── SMS (copie des e-mails et des relances) ──────────────────────────
# Voir SMS_CONFIGURATION_GUIDE.md. Ne mettre SMS_ENABLED=True qu'après
# « manage.py sms_check » réussi (numéro vérifié sur le compte Twilio).
SMS_ENABLED=False
SMS_PROVIDER=twilio
SMS_FROM_NUMBER=+12157155406
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
SMS_STATUS_CALLBACK_URL=https://globalfeba.com/api/notifications/sms/status/
SMS_REQUIRE_EXPLICIT_CONSENT=True
SMS_DEFAULT_REGIONS=FEBA:BJ
SMS_MAX_MESSAGES_PER_NOTIFICATION=5

# ── Gabarits de diplômes et certificats ───────────────────────────────
# Délai maximal (secondes) de conversion d'un gabarit Word / OpenDocument /
# RTF / PowerPoint par LibreOffice (installé dans l'image). Facultatif.
DOCUMENT_CONVERSION_TIMEOUT=90
# Chemin de soffice : détecté automatiquement, à ne renseigner qu'en cas
# d'installation non standard.
LIBREOFFICE_BINARY=

# ── Rattachement du site public (facultatif) ──────────────────────────
# Académie qui reçoit les inscriptions et tests de placement « en ligne »
# du site public, et ses rapports mensuels ; académie présentielle qui
# reçoit les préinscriptions et messages du site. Les menus correspondants
# n'apparaissent QUE pour ces académies.
PUBLIC_SITE_ONLINE_ACADEMY_CODE=FEBA_FHA
PUBLIC_SITE_CAMPUS_ACADEMY_CODE=FEBA
