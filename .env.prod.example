# ============================================================
# FEBA School Management — Configuration PRODUCTION
# Copiez ce fichier en .env.prod et remplissez les valeurs
# ============================================================

DJANGO_ENV=prod

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET_KEY

# Base de données
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://feba_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres-prod:5432/feba_prod

# Redis
REDIS_URL=redis://redis-prod:6379/0

# CORS & Hôtes (remplacez votre-domaine.com par votre domaine réel)
CORS_ALLOWED_ORIGINS=https://globalfeba.com,https://www.globalfeba.com

# Origines autorisées à envoyer un POST avec cookie de session.
# INDISPENSABLE derrière le proxy TLS : sans cette variable, la connexion
# à /django-admin/ est refusée (« Origin checking failed »). Le schéma est
# obligatoire. Vide = dérivé d'ALLOWED_HOSTS en https.
CSRF_TRUSTED_ORIGINS=https://globalfeba.com,https://www.globalfeba.com
ALLOWED_HOSTS=globalfeba.com,www.globalfeba.com

# Médias
MEDIA_ROOT=/app/media

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Sécurité HTTPS
SECURE_SSL_REDIRECT=True
HSTS_SECONDS=31536000

# Email SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.votre-fournisseur.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@votre-domaine.com
EMAIL_HOST_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@votre-domaine.com

# ── Salles virtuelles : instance Jitsi AUTO-HÉBERGÉE ────────────────────
#
# `meet.jit.si` n'est pas une valeur acceptable ici, et le backend la
# refuse : les cours de FEBA FHA sont donnés à des mineurs, et une
# instance publique signifie flux chez un tiers, aucune authentification,
# et n'importe qui capable de deviner un nom de salle qui entre dedans.
#
# Domaine de l'instance du groupe (voir JITSI_PRODUCTION_GUIDE.md).
JITSI_DOMAIN=meet.globalfeba.com

# Secrets JWT — OBLIGATOIRES. Seul le backend les connaît : c'est ce qui
# fait qu'aucune salle ne s'ouvre sans une autorisation vérifiée par
# Django. Mêmes valeurs que .env.jitsi côté serveur Jitsi.
#   openssl rand -hex 32
JITSI_APP_ID=CHANGE_ME_JITSI_APP_ID
JITSI_APP_SECRET=CHANGE_ME_JITSI_APP_SECRET

# Adresse interne pour le healthcheck backend → Jitsi. Vide quand les deux
# services sont sur des serveurs distincts (le backend sonde alors
# https://meet.globalfeba.com) ; http://jitsi-web:80 s'ils partagent le
# même réseau Docker.
JITSI_INTERNAL_URL=

# ── Identité institutionnelle ───────────────────────────────────────────
# Numéro imprimé sur TOUS les documents officiels. Vide = 0160011717
# (valeur de référence, apps/schools/institution.py). À ne renseigner que
# pour un CHANGEMENT de ligne téléphonique du groupe.
FEBA_OFFICIAL_PHONE=
