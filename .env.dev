DJANGO_ENV=dev
SECRET_KEY=dev-secret-key-not-for-production-use-change-me
DATABASE_URL=postgresql://feba_user:feba_dev_pass@postgres-dev:5432/feba_dev
REDIS_URL=redis://redis-dev:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,backend-dev
MEDIA_ROOT=/app/media
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Salles virtuelles (visioconférence) — domaine Jitsi Meet
JITSI_DOMAIN=

# Instance Jitsi auto-hébergée (JWT) — voir docker-compose.jitsi.yml
JITSI_APP_ID=
JITSI_APP_SECRET=
