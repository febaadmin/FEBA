# ============================================================================
# FEBA School Management — fichier d'environnement d'exemple (AUCUN secret réel)
#
# Copier selon l'environnement :
#   Développement docker : cp .env.example .env.dev   (valeurs ci-dessous OK)
#   Production           : cp .env.example .env.prod  (REMPLIR toutes les
#                          valeurs marquées « OBLIGATOIRE PROD »)
# ============================================================================

# --- Django -----------------------------------------------------------------
# Environnement de settings chargé par feba_project/settings/__init__.py :
#   dev | prod   (mode démo local sans Docker : DJANGO_SETTINGS_MODULE=feba_project.settings.dev_sqlite)
DJANGO_ENV=dev

# Clé secrète Django. OBLIGATOIRE PROD : générer une valeur unique, ex. :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-generate-a-unique-secret-key

# Hôtes autorisés (séparés par des virgules). OBLIGATOIRE PROD : votre domaine.
ALLOWED_HOSTS=localhost,127.0.0.1,backend-dev

# --- Base de données ---------------------------------------------------------
# PostgreSQL. En docker dev, l'hôte est le nom du service compose.
# OBLIGATOIRE PROD : identifiants forts + hôte de votre serveur.
DATABASE_URL=postgresql://feba_user:feba_dev_pass@postgres-dev:5432/feba_dev

# --- Cache / files d'attente -------------------------------------------------
# Redis (cache + broker Celery + channels WebSocket).
REDIS_URL=redis://redis-dev:6379/0

# --- Frontend / CORS ----------------------------------------------------------
# Origines autorisées à appeler l'API (séparées par des virgules).
# OBLIGATOIRE PROD : https://votre-domaine
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Médias -------------------------------------------------------------------
# Répertoire des fichiers uploadés (avatars, justificatifs, bulletins PDF…).
MEDIA_ROOT=/app/media

# --- JWT ----------------------------------------------------------------------
# Durées de vie des jetons (rotation + blacklist activées dans les settings).
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- E-mail -------------------------------------------------------------------
# Dev : console (affiche les e-mails dans les logs). PROD : backend SMTP, ex. :
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   + EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD / EMAIL_USE_TLS
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Sécurité production (lues par settings/prod.py) ---------------------------
# Redirection HTTPS forcée (mettre False uniquement derrière un proxy TLS déjà géré)
SECURE_SSL_REDIRECT=True
# Durée HSTS en secondes (31536000 = 1 an)
HSTS_SECONDS=31536000

# --- Salles virtuelles (visioconférence Jitsi Meet) -----------------------------
# Domaine Jitsi. Laisser vide tant qu'aucun serveur Jitsi privé n'est configuré.
# Production : votre instance auto-hébergée (docker-compose.jitsi.yml).
JITSI_DOMAIN=
# Identifiants JWT de l'instance auto-hébergée (vides = mode démo sans JWT).
# OBLIGATOIRE si instance auto-hébergée — mêmes valeurs que .env.jitsi.
JITSI_APP_ID=
JITSI_APP_SECRET=

# --- Tests PostgreSQL (optionnel, voir settings/test_postgres.py) ---------------
# TEST_DB_NAME=feba_test
# TEST_DB_USER=feba_user
# TEST_DB_PASSWORD=feba_dev_pass
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
