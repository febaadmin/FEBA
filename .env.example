# ============================================================================
# FEBA School Management — fichier d'environnement d'exemple (AUCUN secret réel)
#
# Copier selon l'environnement :
#   Développement docker : cp .env.example .env.dev   (valeurs ci-dessous OK)
#   Production           : cp .env.example .env.prod  (REMPLIR toutes les
#                          valeurs marquées « OBLIGATOIRE PROD »)
# ============================================================================

# --- Django -----------------------------------------------------------------
# Environnement de settings chargé par feba_project/settings/__init__.py :
#   dev | prod   (mode démo local sans Docker : DJANGO_SETTINGS_MODULE=feba_project.settings.dev_sqlite)
DJANGO_ENV=dev

# Clé secrète Django. OBLIGATOIRE PROD : générer une valeur unique, ex. :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-generate-a-unique-secret-key

# Hôtes autorisés (séparés par des virgules). OBLIGATOIRE PROD : votre domaine.
ALLOWED_HOSTS=localhost,127.0.0.1,backend-dev

# --- Base de données ---------------------------------------------------------
# PostgreSQL. En docker dev, l'hôte est le nom du service compose.
# OBLIGATOIRE PROD : identifiants forts + hôte de votre serveur.
DATABASE_URL=postgresql://feba_user:feba_dev_pass@postgres-dev:5432/feba_dev

# --- Cache / files d'attente -------------------------------------------------
# Redis (cache + broker Celery + channels WebSocket).
REDIS_URL=redis://redis-dev:6379/0

# --- Frontend / CORS ----------------------------------------------------------
# Origines autorisées à appeler l'API (séparées par des virgules).
# OBLIGATOIRE PROD : https://votre-domaine
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Médias -------------------------------------------------------------------
# Répertoire des fichiers uploadés (avatars, justificatifs, bulletins PDF…).
MEDIA_ROOT=/app/media

# --- JWT ----------------------------------------------------------------------
# Durées de vie des jetons (rotation + blacklist activées dans les settings).
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- E-mail -------------------------------------------------------------------
# NOTE (P11) — Ce fichier est un gabarit de RÉFÉRENCE générique, couvrant
# aussi bien le développement que la production. Il n'est chargé par
# AUCUN service : docker-compose.yml lit `.env.dev` (voir
# .env.dev.example, qui pointe déjà vers Mailpit par défaut en
# développement). Ne créez PAS de `.env` isolé en pensant qu'il sera pris
# en compte — voir `make doctor`, qui le signale explicitement.
#
# Dev : console (les e-mails s'affichent dans les logs et NE PARTENT PAS).
# PROD : backend SMTP, avec un serveur réellement joignable.
#
# Vérifier la configuration, puis l'éprouver par un envoi réel :
#   python manage.py email_check
#   python manage.py email_check --to vous@exemple.test
#
# La commande sort en erreur si le backend est un backend de développement :
# un message écrit dans la console n'est pas un message envoyé.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
# OBLIGATOIRE PROD — jeton d'application du fournisseur. Laissé VIDE ici :
# ce fichier est versionné et ne doit contenir aucun secret.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Délai maximal d'une opération SMTP, en secondes. Sans lui, un serveur
# injoignable bloque la requête d'un parent jusqu'au timeout du système.
EMAIL_TIMEOUT=10

# ── Mailpit : vérifier un envoi au lieu de le supposer ────────────────
#
# En développement, `docker compose up` démarre Mailpit. Pour que les
# messages y arrivent réellement — et donc pour pouvoir OUVRIR la pièce
# jointe d'un rapport mensuel et vérifier destinataire, objet, langue et
# type MIME — remplacer les deux lignes ci-dessus par :
#
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=mailpit
#   EMAIL_PORT=1025
#   EMAIL_USE_TLS=False
#
# Interface de lecture : http://localhost:8025
# Mailpit ne relaie rien vers l'extérieur : aucun parent réel ne reçoit
# quoi que ce soit, et aucun identifiant n'est nécessaire.

# ── P3 — Rapports mensuels FEBA FHA ───────────────────────────────────
#
# Jour, heure et minute du déclenchement mensuel. Le lot rend compte du
# mois ÉCOULÉ : une école qui clôture ses saisies le 3 ne veut pas d'un
# rapport produit le 1er, qui rendrait compte d'un mois incomplet tout en
# ayant l'air définitif.
MONTHLY_REPORTS_DAY=1
MONTHLY_REPORTS_HOUR=6
MONTHLY_REPORTS_MINUTE=0

# False (défaut) — les rapports sont produits, puis un administrateur
#                  relit et déclenche l'envoi ;
# True           — envoi immédiat après génération.
#
# Le défaut est False PARCE QUE l'envoi automatique d'un document
# nominatif à des familles ne doit pas s'activer par surprise.
MONTHLY_REPORTS_AUTO_SEND=False

# Expéditeur par défaut, et expéditeur PROPRE À CHAQUE ACADÉMIE. Un parent de
# l'académie en ligne ne doit pas recevoir un message venant de l'adresse de
# l'école présentielle : il répondrait au mauvais secrétariat.
DEFAULT_FROM_EMAIL=noreply@feba.bj
FEBA_FROM_EMAIL=
FHA_FROM_EMAIL=
# Adresse à laquelle les réponses arrivent, si elle diffère de l'expéditeur.
EMAIL_REPLY_TO=

# --- Sécurité production (lues par settings/prod.py) ---------------------------
# Redirection HTTPS forcée (mettre False uniquement derrière un proxy TLS déjà géré)
SECURE_SSL_REDIRECT=True
# Durée HSTS en secondes (31536000 = 1 an)
HSTS_SECONDS=31536000

# --- Salles virtuelles (visioconférence Jitsi Meet) -----------------------------
#
# INSTANCE AUTO-HÉBERGÉE UNIQUEMENT. `meet.jit.si` et les autres instances
# publiques sont REFUSÉES par le backend (JITSI_FORBIDDEN_DOMAINS) : elles
# feraient transiter des cours de mineurs par un serveur tiers, sans
# authentification. Une configuration incomplète produit une erreur
# d'infrastructure explicite, jamais une session publique.
#
# Production FEBA : l'instance du groupe.
JITSI_DOMAIN=meet.globalfeba.com
# Identifiants JWT — OBLIGATOIRES : sans secret, aucun jeton ne peut être
# signé, donc aucune salle ne peut être protégée. Mêmes valeurs que
# .env.jitsi. Générés par « make install » ; en production, générez-les
# avec « openssl rand -hex 32 » et ne les commitez jamais.
JITSI_APP_ID=
JITSI_APP_SECRET=
# Adresse INTERNE utilisée par le backend pour sonder Jitsi (healthcheck).
# Vide en production quand backend et Jitsi partagent la même adresse
# publique ; http://jitsi-web:80 quand la pile tourne dans le même Docker.

# --- Tests PostgreSQL (optionnel, voir settings/test_postgres.py) ---------------
# TEST_DB_NAME=feba_test
# TEST_DB_USER=feba_user
# TEST_DB_PASSWORD=feba_dev_pass
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432

# --- Paiement par carte bancaire (V8) -------------------------------------------
# Les clés viennent du tableau de bord du prestataire (Stripe →
# « Développeurs → Clés API »). AUCUNE valeur réelle ne doit être commitée :
# ce fichier est un modèle, le fichier .env est ignoré par Git.
#
# Configuration guidée et vérifiée :  make payments-setup
# Vérification des identifiants     :  make payments-check
# Diagnostic des événements reçus   :  make payments-webhook-check
#
# Tant que CARD_PAYMENTS_ENABLED vaut False, le bouton « Payer par carte »
# n'apparaît nulle part : mieux vaut aucune option qu'une option qui échoue.
CARD_PAYMENTS_ENABLED=False
PAYMENT_PROVIDER=stripe

# « test » ou « live ». Doit correspondre au préfixe des clés ci-dessous :
# une clé sk_live_ avec STRIPE_MODE=test crée des paiements qui ne seront
# jamais confirmés — et inversement, une démonstration débiterait de
# vraies cartes.
STRIPE_MODE=test

# sk_test_… ou sk_live_…  — SECRÈTE : jamais exposée au navigateur.
STRIPE_SECRET_KEY=
# pk_test_… ou pk_live_…  — publique, utilisée par le formulaire hébergé.
STRIPE_PUBLISHABLE_KEY=
# whsec_…  — signe les événements. VIDE = tous les événements sont refusés,
# donc aucun paiement n'est encaissé. C'est volontaire : sans signature,
# n'importe qui pourrait déclarer un paiement réussi.
STRIPE_WEBHOOK_SECRET=

# URL publique de l'application, utilisée pour les pages de retour et pour
# l'adresse du webhook (<PUBLIC_BASE_URL>/api/payments/webhook/stripe/).
# En production, HTTPS est exigé.
PUBLIC_BASE_URL=http://localhost:5173
