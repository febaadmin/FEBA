# ══════════════════════════════════════════════════════════════════════
# Variables de l'instance Jitsi AUTO-HÉBERGÉE.
#
# CE FICHIER NE CONTIENT AUCUN SECRET : il documente les clés attendues.
# Les valeurs réelles sont générées automatiquement par « make install »
# (ou « make jitsi-up ») dans .env.jitsi, ignoré par Git.
#
# Ne renseignez JAMAIS ici de valeur de production.
# ══════════════════════════════════════════════════════════════════════

# Identifiant applicatif partagé backend ↔ Prosody (généré : feba_xxxxxxxx)
JITSI_APP_ID=

# Secret de signature des jetons (openssl rand -hex 32)
JITSI_APP_SECRET=

# Secrets internes de la pile Jitsi (openssl rand -hex 16)
JICOFO_COMPONENT_SECRET=
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
TURN_SECRET=

# URL publique de l'instance.
#   développement : http://localhost:8443
#   production    : https://meet.globalfeba.com
JITSI_PUBLIC_URL=http://localhost:8443

# Ports exposés sur l'hôte (développement). En production, la surcouche
# docker-compose.jitsi.prod.yml impose 80 et 443 : Let's Encrypt valide le
# domaine par HTTP-01 et exige le port 80 joignable depuis l'extérieur.
JITSI_HTTP_PORT=8443
JITSI_HTTPS_PORT=8444

# ══════════════════════════════════════════════════════════════════════
# PRODUCTION — variables lues par docker-compose.jitsi.prod.yml
# ══════════════════════════════════════════════════════════════════════

# Domaine servi par l'instance. Doit être identique à JITSI_DOMAIN côté
# backend (.env.prod) : un écart et les jetons sont refusés, sans message
# côté FEBA. « make jitsi-config-check » vérifie cette égalité.
JITSI_DOMAIN=meet.globalfeba.com

# Adresse recevant les avis d'expiration Let's Encrypt. Seul filet si un
# renouvellement automatique échoue : sans elle, le certificat expire un
# matin et plus aucun cours ne démarre.
LETSENCRYPT_EMAIL=

# IP PUBLIQUE du serveur Jitsi (Hetzner). SANS ELLE, LE SON ET L'IMAGE NE
# PASSENT PAS : le pont vidéo annoncerait son adresse Docker interne
# (172.x), inatteignable depuis Internet. Les participants se voient dans
# la liste et n'entendent rien.
JVB_ADVERTISE_IPS=

# Port UDP du pont vidéo. À ouvrir dans le pare-feu Hetzner
# (voir MANUAL_PRODUCTION_ACTIONS.md).
JVB_PORT=10000

# IPv6 : 0 sur un hôte sans pile IPv6 (sinon nginx boucle au démarrage),
# 1 si votre infrastructure sert de l'IPv6.
ENABLE_IPV6=0

TZ=Africa/Porto-Novo
