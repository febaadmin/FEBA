# ── Pile Jitsi auto-hébergée (docker-compose.jitsi.yml) ─────────────────
# Copier ce fichier en .env.jitsi puis renseigner TOUS les secrets :
#   openssl rand -hex 32   (pour chaque valeur ci-dessous)

# Identifiant et secret JWT — DOIVENT être identiques à ceux du backend
# FEBA (.env.dev / .env.prod : JITSI_APP_ID / JITSI_APP_SECRET)
JITSI_APP_ID=feba
JITSI_APP_SECRET=CHANGEME_openssl_rand_hex_32

# Mots de passe internes XMPP
JICOFO_AUTH_PASSWORD=CHANGEME_openssl_rand_hex_32
JVB_AUTH_PASSWORD=CHANGEME_openssl_rand_hex_32

# URL publique de l'interface Jitsi
#   local : http://localhost:8443
#   prod  : https://meet.mon-ecole.bj
JITSI_PUBLIC_URL=http://localhost:8443

# Ports exposés (local)
JITSI_HTTP_PORT=8443
JITSI_HTTPS_PORT=8444
JVB_PORT=10000

# En production derrière NAT : IP publique du serveur pour le pont vidéo
# JVB_ADVERTISE_IPS=203.0.113.10

TZ=Africa/Porto-Novo
